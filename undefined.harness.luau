-- proto attribution (for folding repeated helpers, see fold.py): every
-- statement records which script functions (Luraph protos) were on the Lua
-- stack when it was emitted, outermost first, as "pid:invocation,...".
-- pf: closure -> proto (filled where Luraph makes closures), pid: proto -> id,
-- plast: id -> number of its latest entry (tells invocations apart)
local CHAIN = { pf = nil, pid = nil, plast = nil }
function CHAIN.get()
        local pf, pid, plast = CHAIN.pf, CHAIN.pid, CHAIN.plast
        local parts = {}
        local lvl = 3
        local inner = nil
        while true do
                local f = debug.info(lvl, "f")
                if f == nil then break end
                local proto = pf[f]
                local id = proto and pid[proto]
                if id then
                        if id == 1 and #parts > 0 then inner = parts[1] end
                        R.insert(parts, 1, id .. ":" .. R.tostring(plast[id]))
                end
                lvl += 1
        end
        -- the function the first proto (the VM root) called last: the script's
        -- main function when Luraph's bootstrap and the script share one VM
        -- (not a bootstrap probe helper: after it ran, the root itself emits more)
        CHAIN.seen = CHAIN.seen or {}
        if inner and parts[1] == "1:" .. R.tostring(plast[1]) then
                local c = R.tonumber(R.match(inner, "^(%d+):"))
                CHAIN.rootCallee = c
                CHAIN.seen[c] = CHAIN.seen[c] or "ok"
        elseif #parts == 1 and R.match(parts[1], "^1:") then
                for c in R.next, CHAIN.seen do CHAIN.seen[c] = "probe" end
        end
