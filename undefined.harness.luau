end, {
	__eq = function(a, b)
		local x, y = VAL[a], VAL[b]
		return TYPE[a] == TYPE[b] and x.p == y.p and x.l == y.l and x.r == y.r
	end,
	__tostring = function(a)
		local f = VAL[a]
		return string.format("Path2DControlPoint { Position = %s, LeftTangent = %s, RightTangent = %s }",
