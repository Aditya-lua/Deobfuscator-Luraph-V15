        local ok, js = R.pcall(CHAIN.dumpProtos)
        local fs = CHAIN.forceStats
        if fs then
                R.print(R.fmt("%sFORCE calls=%d decoded=%d in %.1fs, %d buffer patches", MARK, fs.calls, fs.got,
                        R.clock() - fs.t0, fs.bufs or 0))
        end
        if (CHAIN.unscrambled or 0) > 0 then R.print(MARK .. "UNSCRAMBLED " .. CHAIN.unscrambled) end
        R.print(MARK .. "PROTOS " .. (ok and js or ("error: " .. R.tostring(js))))
end
for _, key in R.ipairs(NEWCHUNKS) do
        R.print(MARK .. "CHUNK " .. key)
        R.print((R.gsub(NEWCHUNKS[key], ".", function(c) return R.fmt("%02x", R.byte(c)) end)))
end
R.print(R.concat(header, "\n"))
R.print("")
R.print(body)
if CFG.dump_strings then
        R.print(MARK .. "ENVLOG-STRINGS")
        local seen = {}
        for _, s in collected do
                if not seen[s] then
                        seen[s] = true
                        R.print(quote(s))
                end
        end
end
R.print(MARK .. "ENVLOG-END")
if CFG.serve then R.print(SERVE_PAD) end
