                        break
                end
        end
        if #b.lines > MAX_BLOCK then
                R.insert(b.lines, { text = "-- [envlog] block truncated after " .. MAX_BLOCK .. " statements" })
                b.stopped = 0
                R.error(LOOP, 0)
        end
